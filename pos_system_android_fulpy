                       ('Beira Filial', 'Av. Samora Machel', '3 a 4 Lojas', 3500.0, data_expirada, 'Expirada'))
        cursor.execute("INSERT INTO filiais (nome, localizacao, pacote, valor_mensalidade, data_expiracao, estado_licenca) VALUES (?, ?, ?, ?, ?, ?)",
                       ('Supermercado Nampula', 'Av. Eduardo Mondlane', 'Supermercado', 10000.0, data_ativa, 'Ativa'))
        
        # Utilizadores do Sistema (Dono, Gerente, Caixas)
