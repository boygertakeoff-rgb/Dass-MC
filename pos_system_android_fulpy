DB_NAME = "central_corporate_cloud.db"

def inicializar_banco_dados():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    # 1. Tabela de Filiais / Clientes SaaS com preços progressivos
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS filiais (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT UNIQUE,
            localizacao TEXT,
            pacote TEXT,
            valor_mensalidade REAL,
            data_expiracao TEXT,
            estado_licenca TEXT
        )
    """)
    
    # 2. Tabela de Utilizadores (Segurança de Perfis)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS utilizadores (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE,
            password TEXT,
            perfil TEXT,
            filial_id INTEGER,
            FOREIGN KEY(filial_id) REFERENCES filiais(id)
        )
    """)
    
    # 3. Tabela de Produtos (Isolamento e Preços por Filial)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS produtos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            codigo_barras TEXT,
            nome TEXT,
            preco REAL,
            stock_atual INTEGER,
            stock_minimo INTEGER,
            filial_id INTEGER,
            FOREIGN KEY(filial_id) REFERENCES filiais(id)
        )
    """)
    
    # 4. Tabela de Vendas Globais (Histórico e Gráficos)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS vendas (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            filial_id INTEGER,
            operador TEXT,
            total REAL,
            metodo_pagamento TEXT,
            data_hora TEXT,
            FOREIGN KEY(filial_id) REFERENCES filiais(id)
        )
    """)
    
    # 5. Fila de Sincronização Cloud (Resiliência Offline)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS cloud_sync_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            operacao TEXT,
            dados_json TEXT,
            estado TEXT DEFAULT 'Pendente'
        )
    """)

    # Carga Inicial de Dados de Simulação (Meticais)
